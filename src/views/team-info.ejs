<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/team-info.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.js"></script>

<body>
  <div class="team-info-container">
    <div class="navigation-menu" role="navigation">
      <ul class="nav justify-content-center">
        <li class="nav-item">
          <a class="nav-link active" href="/member">Home</a>
        </li>
        <% if(!member) { %>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/member/signup">Signup</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/member/login">Login</a>
        </li>
        <% } else { %>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/member/teamInfo">Team-info</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="javascript:void(0);" onclick="logout()"
            >Logout</a
          >
        </li>
        <% } %>
      </ul>
    </div>

    <div class="users-frame">
      <div class="board">
        <div class="user-table">
          <table class="table table-hover table-sm">
            <thead class="thead-light">
              <tr class="thead-light">
                <th scope="col">Name</th>
                <th scope="col">Email</th>
                <th scope="col">Link</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <button id="statusButton" class="btn">
              <% if (user.status === 'member') { %>
              <span id="statusText">Check</span>
              <% } else if (user.status === 'processing') { %>
              <div id="spinner" style="display: none">Processing...</div>
              <% } else if (user.status === 'rejected') { %>
              <span id="statusText">Check</span>
              <% } %>
            </button>
            <img id="spinner" src="path/to/spinner.gif" style="display: none" />
          </table>
        </div>
      </div>
    </div>
  </div>

  <script type="text/javascript" src="/js/team-info.js"></script>
</body>

<%- include('includes/footer') %>
